{
   "editable": true,
   "graphTooltip": 1,
   "panels": [
      {
         "collapsed": false,
         "gridPos": {
            "h": 1,
            "w": 0,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "panels": [ ],
         "title": "Cluster",
         "type": "row"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
         },
         "fieldConfig": {
            "defaults": {
               "mappings": [
                  {
                     "options": {
                        "0": {
                           "color": "green",
                           "text": "GREEN"
                        }
                     },
                     "type": "value"
                  },
                  {
                     "options": {
                        "1": {
                           "color": "yellow",
                           "text": "YELLOW"
                        }
                     },
                     "type": "value"
                  },
                  {
                     "options": {
                        "2": {
                           "color": "red",
                           "text": "RED"
                        }
                     },
                     "type": "value"
                  }
               ]
            }
         },
         "gridPos": {
            "h": 4,
            "w": 4,
            "x": 0,
            "y": 1
         },
         "id": 2,
         "options": {
            "colorMode": "background",
            "graphMode": "none"
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "max(opensearch_cluster_status{cluster=\"$cluster\"})",
               "intervalFactor": 2,
               "legendFormat": ""
            }
         ],
         "title": "Cluster status",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
         },
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "axisPlacement": "hidden",
                  "drawStyle": "bars",
                  "fillOpacity": 100,
                  "showPoints": "never",
                  "stacking": {
                     "mode": "percent"
                  }
               },
               "max": 100,
               "min": 0,
               "unit": "none"
            },
            "overrides": [
               {
                  "matcher": {
                     "id": "byName",
                     "options": "GREEN"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "fixedColor": "green",
                           "mode": "fixed"
                        }
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "YELLOW"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "fixedColor": "yellow",
                           "mode": "fixed"
                        }
                     }
                  ]
               },
               {
                  "matcher": {
                     "id": "byName",
                     "options": "RED"
                  },
                  "properties": [
                     {
                        "id": "color",
                        "value": {
                           "fixedColor": "red",
                           "mode": "fixed"
                        }
                     }
                  ]
               }
            ]
         },
         "gridPos": {
            "h": 4,
            "w": 8,
            "x": 4,
            "y": 1
         },
         "id": 3,
         "options": {
            "legend": {
               "showLegend": false
            }
         },
         "pluginVersion": "v13.0.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "(opensearch_cluster_status{cluster=\"$cluster\"} == 0) + 1",
               "intervalFactor": 10,
               "legendFormat": "GREEN"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "(opensearch_cluster_status{cluster=\"$cluster\"} == 1)",
               "intervalFactor": 10,
               "legendFormat": "YELLOW"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "$datasource"
               },
               "expr": "(opensearch_cluster_status{cluster=\"$cluster\"} == 2) - 1",
               "intervalFactor": 10,
               "legendFormat": "RED"
            }
         ],
         "title": "Cluster Health History",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
         },
         "gridPos": {
            "h": 4,
